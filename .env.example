# Enable real LangChain agents by selecting a provider:model supported by LangChain.
# Example: openai:gpt-5.5
# Leave empty to run the deterministic local showcase without sending data externally.
PROCUREMENT_MODEL=

# Required only for the selected provider.
OPENAI_API_KEY=

# Optional: tracing is off by default so the local demo does not export case data.
# Use fictional/anonymized data only when enabling LangSmith Cloud.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-procurement-orchestration
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Supabase server-side integration. Never put SERVICE_ROLE_KEY in Lovable,
# Streamlit client-side code, or any other browser-delivered environment.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only Postgres connection string from Supabase Dashboard > Connect.
# Required for durable LangGraph HITL checkpoints in deployed environments.
LANGGRAPH_DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@<supabase-host>:5432/postgres?sslmode=require
LANGGRAPH_CHECKPOINT_SCHEMA=langgraph
# Comma-separated browser origins allowed to call this API.
CORS_ALLOWED_ORIGINS=https://request-hub-alpha.vercel.app
# Browser applications use a separate, safe-to-expose publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
DEMO_API_TOKEN=replace-with-a-long-random-local-token
